# =============================================================================
# SMT HUB — Modèle de configuration
# -----------------------------------------------------------------------------
# 1. Copiez ce fichier en « .env.local » (dev) ou « .env » (prod) :
#        cp .env.example .env.local
# 2. Renseignez au minimum les 2 variables OBLIGATOIRES (section Sécurité).
# 3. Ne committez JAMAIS votre .env / .env.local (déjà ignorés par git).
# =============================================================================


# -----------------------------------------------------------------------------
# SÉCURITÉ — OBLIGATOIRE EN PRODUCTION
# (l'application refuse de démarrer en production si ces valeurs manquent)
# -----------------------------------------------------------------------------

# Secret de signature du cookie de session (JWT). Chaîne longue et aléatoire.
# Générer :  openssl rand -base64 48
SESSION_SECRET=

# Clé de chiffrement (AES-256-GCM) du coffre-fort d'identifiants d'applications.
# Doit être DIFFÉRENTE de SESSION_SECRET.  Générer :  openssl rand -base64 48
CREDENTIALS_SECRET=


# -----------------------------------------------------------------------------
# ENVIRONNEMENT
# -----------------------------------------------------------------------------

# « development » en local, « production » sur le serveur.
NODE_ENV=production

# URL publique de l'application (utilisée dans les liens des e-mails, ex. reset).
NEXT_PUBLIC_APP_URL=https://smthub.mon-domaine.com


# -----------------------------------------------------------------------------
# BASE DE DONNÉES — OPTIONNEL
# Par défaut, l'app fonctionne en mode FICHIERS JSON (dossier data/).
# Pour utiliser PostgreSQL, décommentez les 2 lignes ci-dessous.
# -----------------------------------------------------------------------------

# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/smthub


# -----------------------------------------------------------------------------
# STOCKAGE FICHIERS (mode JSON) — OPTIONNEL
# -----------------------------------------------------------------------------

# Dossier des données JSON (par défaut : ./data)
# DATA_DIR=/var/lib/smthub/data

# Sauvegardes automatiques du dossier data
# AUTO_BACKUP=false
# BACKUP_DIR=/var/backups/smthub
# MAX_BACKUPS=10


# -----------------------------------------------------------------------------
# SMTP (e-mails) — OPTIONNEL
# La configuration SMTP se fait principalement dans l'interface admin
# (onglet « Configuration Emails »). Le mot de passe peut aussi être fourni ici.
# -----------------------------------------------------------------------------

# SMTP_PASS=mot_de_passe_ou_app_password


# -----------------------------------------------------------------------------
# COMPTE ADMINISTRATEUR INITIAL — utilisé par « npm run seed:admin »
# (aucun admin par défaut n'est livré ; créez le vôtre)
#   ADMIN_EMAIL=admin@mon-domaine.com ADMIN_PASSWORD='MotDePasseFort!' npm run seed:admin
# -----------------------------------------------------------------------------

# ADMIN_EMAIL=admin@mon-domaine.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrateur


# -----------------------------------------------------------------------------
# RÉINITIALISATION DE MOT DE PASSE — utilisé par « npm run reset:password »
#   USER_EMAIL=... NEW_PASSWORD=... npm run reset:password
# (ou passez par la page Profil dans l'application)
# -----------------------------------------------------------------------------

# USER_EMAIL=
# NEW_PASSWORD=
