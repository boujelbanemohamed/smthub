# Configuration de base
NODE_ENV=production
PORT=4000

# Configuration de base de données
# Recommandé en production (surtout en serverless : Vercel, conteneurs).
# Si DATABASE_URL est défini, l'app utilise PostgreSQL via Prisma.
# Sinon, elle bascule en mode fichier (data/*.json) -> à réserver à un
# serveur unique persistant (VPS). Voir PRODUCTION.md.
# DATABASE_URL=postgresql://user:password@host:5432/smthub
# DATABASE_TYPE=postgresql

# Compte administrateur initial (utilisé par `npm run seed:admin`).
# Aucun compte admin par défaut n'est livré : créez le vôtre ici.
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_NAME=Administrateur

# Configuration SMTP (optionnel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@smt.com

# Configuration de sécurité
# Obligatoire : secret utilisé pour signer le cookie de session (JWT).
# Générer une valeur forte, ex: openssl rand -base64 48
SESSION_SECRET=change_this_to_a_long_random_value_in_production

# Obligatoire : clé de chiffrement (AES-256-GCM) des identifiants d'applications
# enregistrés par les utilisateurs (coffre-fort). Générer : openssl rand -base64 48
CREDENTIALS_SECRET=change_this_to_another_long_random_value

# Configuration des logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Configuration du cache
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Configuration de l'application
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Configuration des performances
NEXT_PUBLIC_ENABLE_CACHE=true
NEXT_PUBLIC_ENABLE_LOGGING=true 